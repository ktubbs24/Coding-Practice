filters:
  and:
    - file.folder == "Timeline"
    - and:
        - file.name.containsAny("2025")
properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: Overview
    filters:
      and:
        - file.name.containsAny("2025")
    order:
      - status
      - file.name
      - topic
    sort:
      - property: topic
        direction: ASC
      - property: level
        direction: DESC
      - property: file.mtime
        direction: DESC
    columnSize:
      note.cards-made: 117
      file.name: 290
    rowHeight: medium
  - type: table
    name: Needs Review
    filters:
      and:
        - devlogReviewed != true
    order:
      - status
      - topic
      - file.name
      - devlogReviewed
    sort:
      - property: topic
        direction: ASC
      - property: level
        direction: DESC
      - property: file.mtime
        direction: DESC
    columnSize:
      note.cards-made: 117
      file.name: 290
    rowHeight: medium
  - type: table
    name: Needs Cards Made
    filters:
      and:
        - note["cards-made"] != true
    order:
      - status
      - topic
      - file.name
      - cards-made
    sort:
      - property: topic
        direction: ASC
      - property: level
        direction: DESC
      - property: file.mtime
        direction: DESC
    columnSize:
      note.cards-made: 117
      file.name: 290
    rowHeight: medium
